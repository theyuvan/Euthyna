# --- Database (Supabase) -----------------------------------------------------------
# Use the DIRECT connection or the SESSION pooler (port 5432). The transaction pooler (6543)
# breaks the per-vault advisory lock. Supabase > Project Settings > Database > Connection string.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Arc testnet --------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.network
EXPLORER_URL=https://testnet.arcscan.app
# Set after deploying (npm run deploy-factory, or forge script in contracts/)
FACTORY_ADDRESS=
FACTORY_START_BLOCK=0

# --- Execution -----------------------------------------------------------------------
# circle: each vault's agent is a Circle dev-controlled SCA wallet (gas via Gas Station)
# local:  one raw key acts as agent (testing before Circle is ready)
EXECUTOR=circle
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_FEE_LEVEL=MEDIUM
AGENT_PRIVATE_KEY=

# --- LLM ------------------------------------------------------------------------------
# Pick one provider. The model only proposes actions; policy.ts and the contract gate money
# either way, so this choice never affects what the agent is allowed to do.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# xAI (Grok): console.x.ai (a separate product/billing from grok.com's own API keys)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Gemini: aistudio.google.com/apikey — free tier, no credit card. Avoid gemini-3.8-flash for
# this loop (it's a reasoning model and can spend its whole token budget on hidden thinking,
# returning empty content); gemini-3.5-flash-lite or gemini-flash-latest work well.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
PROMPT_VERSION=euthyna-v1

# --- Loops ----------------------------------------------------------------------------
AGENT_INTERVAL_MIN=30
SETTLER_INTERVAL_MIN=10
INDEXER_INTERVAL_SEC=60
AUTO_PAY_WITHIN_HOURS=2

# --- API --------------------------------------------------------------------------------
PORT=8787
ADMIN_TOKEN=change-me
CORS_ORIGIN=*

# --- Scripts only (never needed by the running worker) ----------------------------------
DEPLOYER_PRIVATE_KEY=
OWNER_PRIVATE_KEY=
